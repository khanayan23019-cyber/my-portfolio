    </div>

  <script>
    const motionTargets = document.querySelectorAll(
      ".panel, .two-column, .project-card, .tool-item, .about-facts, .site-footer"
    );

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduceMotion && "IntersectionObserver" in window) {
      document.documentElement.classList.add("motion-ready");

      motionTargets.forEach((element) => {
        element.classList.add("reveal-on-scroll");
      });

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -35px 0px" }
      );

      motionTargets.forEach((element) => revealObserver.observe(element));
    }
  </script>

<script>
  const revealElements = document.querySelectorAll(
    ".about-panel, .approach-panel, .work-panel, " +
    ".toolkit-panel, .contact-panel, .project-card, " +
    ".about-facts, .tool-item"
  );

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (prefersReducedMotion || !("IntersectionObserver" in window)) {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  } else {
    revealElements.forEach((element) => {
      element.classList.add("reveal-on-scroll");
    });

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -40px 0px"
      }
    );

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });
  }
</script>

  </body>
</html>

<style>
  :root {
    --cream: #fff7e8;
    --paper: #fffdf9;
    --ink: #171717;
    --blue: #2458ff;
    --blue-light: #dfe7ff;
    --muted: #64615d;
    --line: #ded8cd;
    --pink: #f7dce6;
    --green: #dff0d5;
    --orange: #ffb27d;
    --display: "Bebas Neue", Impact, sans-serif;
    --body: "DM Sans", Arial, sans-serif;
    --script: "Caveat", cursive;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--cream); }
  body { margin: 0; background: var(--cream); color: var(--ink); font-family: var(--body); }
  a { color: inherit; }
  .page-shell { width: min(1440px, 100%); margin: 0 auto; padding: 0 22px 24px; }
  .page-title { padding: 22px 0 14px; text-align: center; font: 400 clamp(30px, 5vw, 62px)/.95 var(--display); letter-spacing: .025em; }
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 20px 28px; margin-bottom: 18px; background: rgba(255,253,249,.94); border: 1px solid #e9e2d6; box-shadow: 0 8px 22px #241d111a; }
  .brand { font: 400 25px/1 var(--display); text-decoration: none; white-space: nowrap; }
  .brand span, .work-heading h2 span, .toolkit-intro h2 span, .contact-left h2 span, .hero h1 span { color: var(--blue); }
  .site-header nav { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: clamp(14px, 3vw, 38px); }
  .site-header nav a { font-size: 12px; font-weight: 800; text-decoration: none; }
  .site-header nav a:hover, .text-link:hover { color: var(--blue); }
  .panel { position: relative; overflow: hidden; margin-bottom: 18px; border: 1px solid #e9e2d6; background: var(--paper); box-shadow: 0 8px 22px #241d111a; }
  .hero { display: grid; grid-template-columns: 1.05fr .95fr; min-height: 410px; padding: clamp(28px, 5vw, 64px); }
  .hero-copy { position: relative; z-index: 2; align-self: center; }
  .eyebrow, .section-index { display: block; margin: 0 0 20px; font-size: 10px; font-weight: 800; letter-spacing: .14em; }
  .eyebrow { color: var(--blue); }
  .script-word { margin: 0 0 -4px; color: var(--blue); font: 600 clamp(32px, 4vw, 51px)/.9 var(--script); transform: rotate(-3deg); transform-origin: left center; }
  .hero h1 { position: relative; z-index: 2; margin: 0; font: 400 clamp(76px, 12vw, 150px)/.76 var(--display); letter-spacing: -.015em; }
  .hero-description { max-width: 390px; margin: 25px 0 20px; font-size: 14px; line-height: 1.7; }
  .button { display: inline-flex; align-items: center; justify-content: space-between; gap: 25px; min-width: 170px; padding: 13px 17px; border: 0; text-decoration: none; font-size: 12px; font-weight: 800; transition: transform .2s, box-shadow .2s; }
  .button:hover { transform: translateY(-3px); box-shadow: 0 8px 18px #17171722; }
  .button-blue { background: var(--blue); color: white; }
  .button-dark { background: var(--ink); color: white; }
  .social-icons { display: flex; gap: 10px; margin-top: 23px; }
  .social-icons a { display: grid; width: 31px; height: 31px; place-items: center; border: 1px solid #d8d1c5; border-radius: 50%; font-size: 14px; font-weight: 800; text-decoration: none; }
  .social-icons a:hover { background: var(--blue); border-color: var(--blue); color: white; }
  .hero-art { position: relative; min-height: 310px; align-self: stretch; }
  .portrait-frame { position: absolute; right: 10%; bottom: 0; z-index: 2; display: flex; align-items: end; justify-content: center; width: 65%; height: 88%; overflow: hidden; background: linear-gradient(145deg,#dce6ff,#f5e9d8); border-radius: 48% 48% 5px 5px; }
  .portrait-frame img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  .orbit { position: absolute; border: 1px solid #2458ff55; border-radius: 50%; }
  .orbit-one { width: 280px; height: 280px; right: 2%; top: 4%; }
  .orbit-two { width: 220px; height: 220px; right: 12%; top: 14%; border-style: dashed; }
  .floating-folder { position: absolute; z-index: 3; padding: 12px 10px 7px; min-width: 78px; background: #fffdf9; box-shadow: 0 5px 15px #17171714; font-size: 9px; font-weight: 800; transform: rotate(-5deg); }
  .floating-folder span { display: block; width: 26px; height: 18px; margin-bottom: 7px; border-radius: 4px 6px 2px 2px; background: #f4a7c5; }
  .folder-pink { left: 3%; top: 17%; }
  .folder-orange { right: 0; top: 29%; transform: rotate(5deg); }
  .folder-orange span { background: var(--orange); }
  .folder-green { left: 9%; bottom: 14%; transform: rotate(4deg); }
  .folder-green span { background: #b7df8a; }
  .hero-sticker { position: absolute; z-index: 4; padding: 10px; border: 1px solid var(--ink); background: var(--cream); font: 400 17px/.9 var(--display); text-align: center; transform: rotate(-8deg); }
  .sticker-one { right: 2%; bottom: 14%; }
  .sticker-two { left: 0; bottom: 0; background: var(--blue); color: white; transform: rotate(5deg); }
  .art-caption { position: absolute; right: 2%; bottom: 0; color: var(--muted); font-size: 8px; letter-spacing: .08em; }
  .two-column { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .about-panel, .approach-panel { padding: clamp(22px, 3vw, 35px); }
  .panel-heading h2, .approach-panel h2, .work-heading h2, .toolkit-intro h2, .contact-left h2 { margin: 0; font: 400 clamp(37px, 5vw, 62px)/.87 var(--display); letter-spacing: .01em; }
  .panel-heading h2 span, .approach-panel h2 span { color: var(--blue); }
  .about-body { display: grid; grid-template-columns: .75fr 1fr; gap: 18px; margin-top: 24px; align-items: center; }
  .about-image { position: relative; min-height: 220px; overflow: hidden; background: #e4e8f3; }
