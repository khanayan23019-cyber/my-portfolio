  .approach-steps div { display: grid; grid-template-columns: 34px 1fr 1.2fr; align-items: center; gap: 8px; padding: 11px 0; border-bottom: 1px solid #a8b8e5; }
  .approach-steps span { color: var(--blue); font-size: 9px; font-weight: 800; }
  .approach-steps strong { font-size: 10px; }
  .approach-steps i { font-size: 10px; font-style: normal; }
  .sparkle { position: absolute; color: #2458ff1c; font-size: 110px; line-height: 1; }
  .sparkle-one { right: -10px; top: 55px; }
  .sparkle-two { right: 35px; bottom: 65px; font-size: 52px; }
  .work-panel { padding: clamp(22px, 3vw, 35px); }
