  .approach-panel { background: #dfe7ff; }
  .approach-panel .section-index { color: #384d94; }
  .approach-panel .script-word { margin-top: 30px; }
  .approach-panel h2 { margin-top: 7px; }
  .approach-copy { max-width: 380px; margin: 19px 0; font-size: 12px; line-height: 1.7; }
